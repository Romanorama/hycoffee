---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/portal/login');
}
---

<BaseLayout title="Portal — HyCoffee" noindex={true}>
  <main class="portal">
    <div class="portal-inner">
      <span class="portal-eyebrow caption">Beta · HyCoffee Toolbox</span>
      <h1 class="portal-heading">Willkommen, {session.name}.</h1>
      <p class="portal-lead">
        Du bist eingeloggt als <strong>{session.email}</strong>. Die Toolbox ist im Beta-Stadium —
        Feedback bitte direkt an Roman.
      </p>
      <div class="portal-actions">
        <a class="btn btn-primary" href="/portal/toolbox"><span>Toolbox öffnen</span></a>
        <form method="post" action="/api/logout">
          <button class="btn-ghost" type="submit">Logout</button>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .portal {
    min-height: 100vh;
    background: var(--warm-grey-light);
    border-bottom: 1px solid var(--warm-dark-grey);
    display: grid;
    place-items: center;
    padding: 80px 24px;
  }

  .portal-inner {
    width: 100%;
    max-width: 720px;
    display: grid;
    gap: 24px;
    color: var(--warm-dark-grey);
  }

  .portal-eyebrow {
    color: var(--warm-dark-grey);
    opacity: 0.7;
  }

  .portal-heading {
    font-family: var(--font-heading);
    font-size: var(--type-display-sm);
    line-height: 0.94;
    letter-spacing: -2px;
    font-weight: 400;
    color: var(--warm-dark-grey);
    margin: 0;
  }

  .portal-lead {
    font-family: var(--font-heading);
    font-size: var(--type-hal-copy-lg);
    line-height: 1.4;
    color: var(--warm-dark-grey);
    margin: 0;
  }

  .portal-lead strong { font-weight: 400; }

  .portal-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .portal-actions form { margin: 0; }

  .btn-ghost {
    font-family: var(--font-ui);
    font-size: var(--type-button);
    background: transparent;
    border: 1px solid var(--warm-dark-grey);
    color: var(--warm-dark-grey);
    padding: 14px 24px 6px;
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    line-height: 1;
  }

  .btn-ghost:hover {
    background: var(--warm-dark-grey);
    color: var(--warm-grey-light);
  }

  @media (max-width: 600px) {
    .portal { padding: 48px 20px; }
    .portal-heading { font-size: var(--type-mobile-display); letter-spacing: -1px; }
  }
</style>
