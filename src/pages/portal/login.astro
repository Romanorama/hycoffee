---
export const prerender = false;

const error = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Portal Login — HyCoffee Toolbox</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/Inter-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      :root {
        /* Toolbox greyscale system */
        --hy-white: #ffffff;
        --hy-bg:    #f5f5f7;
        --hy-ink:   #111113;
        --ink-2:    #6e6e73;
        --ink-3:    #a1a1a6;
        --line:        rgba(17, 17, 19, 0.08);
        --line-strong: rgba(17, 17, 19, 0.16);
        --radius-lg: 22px;
        --radius-sm: 10px;
        --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 24px rgba(0, 0, 0, 0.05);
        --font-ui: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, 'Helvetica Neue', Arial, sans-serif;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; min-height: 100%; }

      body {
        font-family: var(--font-ui);
        font-weight: 400;
        letter-spacing: -0.005em;
        line-height: 1.5;
        color: var(--hy-ink);
        background: var(--hy-bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-synthesis: none;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 48px 22px;
      }

      .card {
        width: 100%;
        max-width: 420px;
        background: var(--hy-white);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        padding: 40px;
      }

      .eyebrow {
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-3);
        margin: 0 0 14px;
      }

      h1 {
        font-family: var(--font-ui);
        font-size: 32px;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin: 0;
      }

      .lead {
        font-size: 15px;
        line-height: 1.5;
        color: var(--ink-2);
        margin: 14px 0 0;
      }

      .error {
        font-size: 13px;
        color: var(--hy-ink);
        background: rgba(17, 17, 19, 0.05);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-sm);
        padding: 10px 14px;
        margin: 24px 0 0;
      }

      form {
        display: grid;
        gap: 18px;
        margin-top: 28px;
      }

      .field { display: grid; gap: 8px; }

      .label {
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-3);
      }

      input {
        width: 100%;
        padding: 12px 14px;
        font-family: inherit;
        font-size: 15px;
        color: var(--hy-ink);
        background: var(--hy-white);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-sm);
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      input:focus {
        outline: none;
        border-color: var(--hy-ink);
        box-shadow: 0 0 0 3px rgba(17, 17, 19, 0.08);
      }

      button {
        margin-top: 4px;
        width: 100%;
        padding: 13px 18px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 500;
        color: var(--hy-bg);
        background: var(--hy-ink);
        border: 1px solid var(--hy-ink);
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.15s, transform 0.15s;
      }
      button:hover { background: #000; transform: translateY(-1px); }

      @media (max-width: 480px) {
        .card { padding: 32px 24px; }
        h1 { font-size: 28px; }
      }
    </style>
  </head>
  <body>
    <main class="card">
      <p class="eyebrow">Beta · HyCoffee Toolbox</p>
      <h1>Portal Login</h1>
      <p class="lead">Zugang nur für Beta-Tester. Bitte E-Mail und Passwort eingeben.</p>

      {error && <p class="error">E-Mail oder Passwort falsch.</p>}

      <form method="post" action="/api/login">
        <div class="field">
          <label class="label" for="email">E-Mail</label>
          <input id="email" type="email" name="email" required autocomplete="email" autofocus />
        </div>
        <div class="field">
          <label class="label" for="password">Passwort</label>
          <input id="password" type="password" name="password" required autocomplete="current-password" />
        </div>
        <button type="submit">Anmelden</button>
      </form>
    </main>
  </body>
</html>
