---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const error = Astro.url.searchParams.get('error') === '1';
---

<BaseLayout title="Portal Login — HyCoffee" noindex={true}>
  <main class="portal">
    <div class="portal-inner">
      <span class="portal-eyebrow caption">Beta · HyCoffee Toolbox</span>
      <h1 class="portal-heading">Portal Login</h1>
      <p class="portal-lead">Zugang nur für Beta-Tester. Bitte E-Mail und Passwort eingeben.</p>

      {error && <p class="portal-error">E-Mail oder Passwort falsch.</p>}

      <form class="portal-form" method="post" action="/api/login">
        <label class="portal-field">
          <span>E-Mail</span>
          <input type="email" name="email" required autocomplete="email" autofocus />
        </label>
        <label class="portal-field">
          <span>Passwort</span>
          <input type="password" name="password" required autocomplete="current-password" />
        </label>
        <button class="btn btn-primary" type="submit"><span>Anmelden</span></button>
      </form>
    </div>
  </main>
</BaseLayout>

<style>
  .portal {
    min-height: 100vh;
    background: var(--warm-grey-light);
    border-bottom: 1px solid var(--warm-dark-grey);
    display: grid;
    place-items: center;
    padding: 80px 24px;
  }

  .portal-inner {
    width: 100%;
    max-width: 460px;
    display: grid;
    gap: 24px;
    color: var(--warm-dark-grey);
  }

  .portal-eyebrow {
    color: var(--warm-dark-grey);
    opacity: 0.7;
  }

  .portal-heading {
    font-family: var(--font-heading);
    font-size: var(--type-display-sm);
    line-height: 0.94;
    letter-spacing: -2px;
    font-weight: 400;
    color: var(--warm-dark-grey);
    margin: 0;
  }

  .portal-lead {
    font-family: var(--font-heading);
    font-size: var(--type-hal-copy);
    line-height: 1.5;
    color: var(--warm-dark-grey);
    margin: 0;
  }

  .portal-error {
    font-family: var(--font-ui);
    font-size: var(--type-copy-sm);
    color: #8a2a2a;
    margin: 0;
  }

  .portal-form {
    display: grid;
    gap: 18px;
    margin-top: 8px;
  }

  .portal-field {
    display: grid;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: var(--type-label-lg);
    color: var(--warm-dark-grey);
  }

  .portal-field input {
    font-family: var(--font-heading);
    font-size: var(--type-hal-copy);
    padding: 14px 16px;
    border: 1px solid var(--warm-dark-grey);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--warm-dark-grey);
  }

  .portal-field input:focus {
    outline: 2px solid var(--green);
    outline-offset: 1px;
  }

  .portal-form .btn-primary {
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .portal { padding: 48px 20px; }
    .portal-heading { font-size: var(--type-mobile-display); letter-spacing: -1px; }
  }
</style>
