---
export const prerender = false;

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/portal/login');
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Toolbox — HyCoffee</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/DGMSprinter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face {
        font-family: 'DGM Sprinter';
        src: url('/fonts/DGMSprinter-Regular.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      :root { --bg: #fbf8f2; --ink: #242119; --accent: #3a563b; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'DGM Sprinter', sans-serif;
        display: grid;
        grid-template-rows: auto 1fr;
        height: 100vh;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 18px;
        background: var(--ink);
        color: var(--bg);
        border-bottom: 1px solid rgba(0,0,0,0.1);
      }
      .left { display: flex; align-items: center; gap: 14px; min-width: 0; }
      .badge {
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 4px 8px;
        border: 1px solid currentColor;
        border-radius: 999px;
        opacity: 0.8;
      }
      .who { font-size: 13px; opacity: 0.7; }
      .right { display: flex; align-items: center; gap: 8px; }
      a.back, button.logout {
        font: inherit;
        font-size: 12px;
        background: transparent;
        border: 1px solid currentColor;
        color: currentColor;
        padding: 6px 12px;
        border-radius: 3px;
        cursor: pointer;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      a.back:hover, button.logout:hover { background: var(--bg); color: var(--ink); }
      iframe {
        border: 0;
        width: 100%;
        height: 100%;
        display: block;
        background: var(--bg);
      }
      form { margin: 0; }
    </style>
  </head>
  <body>
    <header>
      <div class="left">
        <span class="badge">Beta</span>
        <span class="who">{session.name} · {session.email}</span>
      </div>
      <div class="right">
        <form method="post" action="/api/logout">
          <button class="logout" type="submit">Logout</button>
        </form>
      </div>
    </header>
    <iframe src="/portal/toolbox-app/index.html" title="HyCoffee Toolbox"></iframe>
  </body>
</html>
